ROLE=scraper

# Общий секрет с лёгким сервером (бот №1) — придумайте длинную случайную строку.
# Должен совпадать с API_TOKEN в .env.bot этого бота.
API_TOKEN=придумайте_длинный_случайный_токен

# Публичный адрес лёгкого сервера (бот №1) — сюда скрапер стучится сам
LIGHT_SERVER_URL=http://IP_ЛЁГКОГО_СЕРВЕРА:8080

# Второй бот (например, платный клон) на том же лёгком сервере — свой
# порт, свой токен (должен совпадать с API_TOKEN в .env.bot2 второго бота).
# Раскомментируйте, если поднимаете docker-compose.bot2.yml:
# LIGHT_SERVER_URL_2=http://IP_ЛЁГКОГО_СЕРВЕРА:8081
# API_TOKEN_2=придумайте_другой_длинный_случайный_токен
#
# Можно добавить и третьего бота: LIGHT_SERVER_URL_3 / API_TOKEN_3, и т.д.
# Скрапер сканирует один раз и рассылает найденные обновления во ВСЕ
# настроенные боты; /scan_city от каждого бота опрашивается отдельно.

# Необязательные:
# SCAN_INTERVAL_MINUTES=12
# MAX_PAYMENT_AGE_MINUTES=20
# STEP_LON=0.3
# STEP_LAT=0.2
# REQUEST_DELAY_SEC=0.4
# DB_PATH=/app/data/stations.db
# COMMAND_POLL_INTERVAL_SEC=5

# Targeted-режим — для GEOBOXES на всю Россию (или просто очень большого):
# фоновый цикл сканирует не все области целиком каждый раз, а только
# станции, которые реально сохранены хоть у кого-то в зонах (Mini App).
# Полный проход по GEOBOXES всё равно происходит, но редко — только чтобы
# обновить каталог/поймать новые станции. См. README, раздел про Mini App.
# TARGETED_SCAN_ENABLED=true
# CATALOG_SWEEP_INTERVAL_HOURS=24
# WATCH_BOX_MARGIN_DEG=0.01
