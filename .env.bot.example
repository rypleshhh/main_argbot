ROLE=bot

BOT_TOKEN=получите_у_BotFather

# Тот же токен, что вписан в API_TOKEN на скрапере
API_TOKEN=придумайте_длинный_случайный_токен

# Этот бот бесплатный — платный доступ отключён (2 кнопки в меню:
# «Действия» / «Подписки», без «Тариф и коины»). Чтобы сделать платным —
# смотрите .env.bot2.example / docker-compose.bot2.yml.
PAYWALL_ENABLED=false

# Необязательные:
# API_HOST=0.0.0.0
# API_PORT=8080
# BOT_DB_PATH=/app/data/bot.db
