ROLE=bot

# Токен ВТОРОГО бота (клон), получите у BotFather отдельно от первого.
BOT_TOKEN=получите_у_BotFather_для_второго_бота

# Секрет для связи со скрапером — должен совпадать с API_TOKEN_2
# в .env.scraper на сервере-скрапере (НЕ с обычным API_TOKEN первого бота).
API_TOKEN=придумайте_другой_длинный_случайный_токен

# Этот бот платный (по умолчанию и так true, оставлено явно для ясности).
PAYWALL_ENABLED=true

# Необязательные:
# API_HOST=0.0.0.0
# API_PORT=8080
# BOT_DB_PATH=/app/data/bot.db

# Доступ: пробный период при первом /start, дальше платная подписка за коины.
# Можно задать другие значения, чем у первого бота — например, здесь
# сделать сразу платный доступ без триала (TRIAL_HOURS=0).
# TRIAL_HOURS=12
# SUBSCRIPTION_DAYS=14
# SUBSCRIPTION_COST_COINS=100

# Telegram Mini App — отдельный API на своём порту, поднимается
# автоматически, т.к. PAYWALL_ENABLED=true (см. app/miniapp_api.py).
# MINIAPP_PORT=8090

# Домен, на который смотрит Caddy (docker-compose.bot2.yml) — Telegram
# требует https, поэтому нужен настоящий домен с DNS, не голый IP.
# DuckDNS (бесплатно) отлично подходит: заведите поддомен на
# https://www.duckdns.org, укажите его тут, и он должен указывать (A/AAAA
# запись) на белый IP этого сервера.
MINIAPP_DOMAIN=findbenz.duckdns.org

# Токен DuckDNS (на https://www.duckdns.org после входа, поле "token"
# вверху страницы) — нужен Caddy для DNS-01 challenge (подтверждение
# домена через DNS, БЕЗ портов 80/443 — они у вас заняты xray/hysteria).
DUCKDNS_TOKEN=вставьте_токен_с_duckdns.org

# Порт, на котором Caddy отдаёт Mini App наружу (80/443 заняты другими
# сервисами). При смене — поменяйте ТАКЖЕ порт в docker-compose.bot2.yml
# (секция caddy -> ports), это два разных места.
MINIAPP_HTTPS_PORT=8443

# Публичный адрес приложения — https://MINIAPP_DOMAIN:MINIAPP_HTTPS_PORT.
# Отсюда бот берёт кнопку «📱 Открыть приложение» в чате (light_bot.py).
# Пока фронтенда/домена ещё нет — оставьте пустым, кнопка не появится.
MINIAPP_URL=https://findbenz.duckdns.org:8443
