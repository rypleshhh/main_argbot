ROLE=bot

# Токен ВТОРОГО бота (клон), получите у BotFather отдельно от первого.
BOT_TOKEN=получите_у_BotFather_для_второго_бота

# Секрет для связи со скрапером — должен совпадать с API_TOKEN_2
# в .env.scraper на сервере-скрапере (НЕ с обычным API_TOKEN первого бота).
API_TOKEN=придумайте_другой_длинный_случайный_токен

# Этот бот платный (по умолчанию и так true, оставлено явно для ясности).
PAYWALL_ENABLED=true

# Необязательные:
# API_HOST=0.0.0.0
# API_PORT=8080
# BOT_DB_PATH=/app/data/bot.db

# Доступ: пробный период при первом /start, дальше платная подписка за коины.
# Можно задать другие значения, чем у первого бота — например, здесь
# сделать сразу платный доступ без триала (TRIAL_HOURS=0).
# TRIAL_HOURS=12
# SUBSCRIPTION_DAYS=14
# SUBSCRIPTION_COST_COINS=100
