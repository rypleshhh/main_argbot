# Порты 80/443 заняты другими сервисами (xray/hysteria) — поэтому НЕ
# используем HTTP-01/TLS-ALPN-01 challenge (им обязательно нужны именно
# эти порты). Вместо этого — DNS-01 через DuckDNS API: подтверждение
# владения доменом идёт через TXT-запись, порты вообще не нужны, Caddy
# слушает на своём отдельном порту MINIAPP_HTTPS_PORT.
#
# {$MINIAPP_DOMAIN}, {$MINIAPP_HTTPS_PORT}, {$DUCKDNS_TOKEN} — из
# .env.bot2 (передаются в контейнер caddy через env_file, см.
# docker-compose.bot2.yml). Токен — на https://www.duckdns.org после
# входа, поле "token" вверху страницы.

{$MINIAPP_DOMAIN}:{$MINIAPP_HTTPS_PORT} {
	log {
		output stdout
		format json
	}
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
	reverse_proxy bot2:8090
}

